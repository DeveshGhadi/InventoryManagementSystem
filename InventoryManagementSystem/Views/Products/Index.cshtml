@model List<Product>
@{
    ViewData["Title"] = "Products";
}

<div class="container mt-4">
    <h2>Products</h2>

    <form method="get" class="mb-3">
        <input type="text" name="search" placeholder="Search by product name" class="form-control">
        <button type="submit" class="btn btn-primary mt-2">Search</button>
    </form>

    <a href="/Products/Create" class="btn btn-success mb-3">Add New Product</a>

    <table class="table table-striped">
        <thead>
            <tr>
                <th>ID</th>
                <th>Product Name</th>
                <th>Category</th>
                <th>Unit Price</th>
                <th>Quantity</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var product in Model)
            {
                <tr>
                    <td>@product.ProductId</td>
                    <td>@product.ProductName</td>
                    <td>@product.Category?.CategoryName</td>
                    <td>$@product.UnitPrice</td>
                    <td>@product.Quantity</td>
                    <td>
                        <a href="/Products/Edit/@product.ProductId" class="btn btn-sm btn-warning">Edit</a>
                        <a href="/Products/Delete/@product.ProductId" class="btn btn-sm btn-danger" onclick="return confirm('Are you sure?')">Delete</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    <a href="/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
</div>
